# Copy this file to .env.local and fill in the values. No quotes, no spaces.
# Never commit .env.local or use these values in browser code.

# Your Supabase project address. Yours is already known:
SUPABASE_URL=https://xpefaztgozmnoluylclh.supabase.co

# The SECRET key from Supabase: Project Settings → API Keys.
# Starts with sb_secret_ (new) or eyJ... labelled service_role (legacy).
# Do NOT use the publishable or anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional free AI from https://aistudio.google.com/apikey
# Leave empty to use the built-in engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
