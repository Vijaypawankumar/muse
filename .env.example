# Copy this file to .env.local and fill in the values.
# Never commit .env.local or put these values in browser code.

# Supabase (free tier). Settings -> API in your Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (free tier, optional). Create a key at https://aistudio.google.com/apikey
# Leave empty to use the built-in idea engine, which works with no AI key at all.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
